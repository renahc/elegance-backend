# Copiar a .env. No versionar credenciales reales.
DB_PASSWORD=replace-with-random-password
RABBITMQ_USER=elegance
RABBITMQ_PASSWORD=replace-with-random-password
RABBITMQ_COOKIE=replace-with-long-random-cookie
DASHBOARD_USER=elegance
DASHBOARD_PASSWORD=replace-with-random-password
AZURE_AD_ISSUER_URI=https://sts.windows.net/7607c5a6-994c-4951-92bc-3af0cf3eb713/
AZURE_AD_CLIENT_ID=304d54f7-d485-478a-a1ea-0c2f874b0c1f
AZURE_AD_JWK_SET_URI=https://login.microsoftonline.com/7607c5a6-994c-4951-92bc-3af0cf3eb713/discovery/v2.0/keys
# Comma-separated Entra usernames/emails granted application admin access.
ELEGANCE_ADMIN_OBJECT_ID=95c6c933-e369-4356-94f6-25c8b89a3919
ELEGANCE_ADMIN_USERNAME=re.herrerac@duocuc.cl
KAFKA_REPLICATION_FACTOR=1
# Usar demo solo para datos ficticios de prueba en el catálogo y CRM.
SPRING_PROFILES_ACTIVE=default
MAIL_USERNAME=
MAIL_PASSWORD=

# Dominio con DNS hacia EC2 para HTTPS público automático.
APP_DOMAIN=localhost
PUBLIC_BIND_ADDRESS=127.0.0.1

# API Gateway URL from Terraform output. Entra API must issue v2 access tokens.
API_GATEWAY_URL=
